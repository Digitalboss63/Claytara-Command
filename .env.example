# Claytara Command — Required Environment Variables
# Copy to .env for local dev. Set ALL in Railway → Variables for production.

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Railway Postgres — use service-specific var name (never raw DATABASE_URL)
CLAYTARA_COMMAND_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://command.claytara.com
PORT=5002
NODE_ENV=production
